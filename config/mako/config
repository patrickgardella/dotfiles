layer=overlay
anchor=top-right
margin=10
padding=15
width=350
height=150
border-size=2
border-radius=10

font=Noto Sans 10
markup=true
actions=true
default-timeout=5000
ignore-timeout=false
max-visible=5

# Collapse repeats of the same notification into one with a count
group-by=app-name,summary

[urgency=low]
border-color=#888888

[urgency=normal]
border-color=#33ccff

[urgency=high]
border-color=#ff4444
default-timeout=10000

default-timeout=60000
ignore-timeout=1
