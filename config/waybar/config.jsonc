{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "custom/kettle",
    "custom/gel-panel",
    "clock",
    "custom/weather",
    "custom/pacman"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "group/temps",
    "pulseaudio",
    "battery",
    "network",
    "tray"
  ],
  "group/temps": {
    "orientation": "horizontal",
    "modules": [
      "temperature#cpu",
      "temperature#gpu",
      "temperature#nvme"
    ]
  },
  "clock": {
    "format": "{:%H:%M  %a %b %d}",
    "tooltip-format": "{:%Y-%m-%d %H:%M}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "MUTED",
    "format-icons": [
      "",
      "",
      ""
    ],
    "on-click": "pavucontrol"
  },
  "cpu": {
    "format": "CPU: {usage}%",
    "format-alt": "{avg_frequency}GHz",
    "interval": 5
  },
  "memory": {
    "format": "Mem: {percentage}%",
    "format-alt": "{used:0.1f}GiB / {total:0.1f}GiB",
    "interval": 10
  },
  "temperature#cpu": {
    "hwmon-path": [
      "/sys/class/hwmon/hwmon3/temp1_input"
    ],
    "warning-threshold": 85,
    "critical-threshold": 95,
    "format": "C: {temperatureC}°C",
    "format-warning": "C: {temperatureC}°C",
    "format-critical": "C: {temperatureC}°C"
  },
  "temperature#gpu": {
    "hwmon-path": [
      "/sys/class/hwmon/hwmon2/temp2_input"
    ],
    "warning-threshold": 95,
    "critical-threshold": 105,
    "format": "G: {temperatureC}°C",
    "format-warning": "G: {temperatureC}°C",
    "format-critical": "G: {temperatureC}°C"
  },
  "temperature#nvme": {
    "hwmon-path": [
      "/sys/class/hwmon/hwmon0/temp1_input"
    ],
    "warning-threshold": 55,
    "critical-threshold": 70,
    "format": "N: {temperatureC}°C",
    "format-warning": "N: {temperatureC}°C",
    "format-critical": "N: {temperatureC}°C"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "all-outputs": true,
    "move-to-monitor": true,
    "persistent-only": false,
    "sort-by": "number"
  },
  "custom/pacman": {
    "format": " {}   ",
    "interval": "3600",
    "on-click": "checkupdates",
    "exec": "checkupdates | wc -l",
    "signal": 8
  },
  "custom/kettle": {
    "exec": "~/.config/waybar/scripts/govee-kettle/govee-kettle status",
    "return-type": "json",
    "interval": 30,
    "on-click": "~/.config/waybar/scripts/govee-kettle/govee-kettle toggle",
    "on-click-right": "~/.config/waybar/scripts/govee-kettle/govee-kettle heat 200",
    "tooltip": true
  },
  "custom/gel-panel": {
    "exec": "/home/patrick/Documents/projects/tuya/.venv/bin/python /home/patrick/Documents/projects/tuya/waybar-panel.py status-json",
    "return-type": "json",
    "interval": 15,
    "on-click": "/home/patrick/Documents/projects/tuya/.venv/bin/python /home/patrick/Documents/projects/tuya/waybar-panel.py toggle",
    "on-click-right": "/home/patrick/Documents/projects/tuya/.venv/bin/python /home/patrick/Documents/projects/tuya/waybar-panel.py temp-next",
    "on-scroll-up": "/home/patrick/Documents/projects/tuya/.venv/bin/python /home/patrick/Documents/projects/tuya/waybar-panel.py bright-up",
    "on-scroll-down": "/home/patrick/Documents/projects/tuya/.venv/bin/python /home/patrick/Documents/projects/tuya/waybar-panel.py bright-down",
    "tooltip": true
  },
  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "interval": 600,
    "return-type": "json"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}\n{power}W"
  },
  "tray": {
    "icon-size": 24,
    "spacing": 4
  },
  "network": {
    "interval": 3,
    "format-ethernet": "{ifname}",
    "format-disconnected": "󰖪 Offline",
    "tooltip-format-ethernet": "󰇚 {bandwidthDownBits} 󰕒 {bandwidthUpBits}"
  }
}
